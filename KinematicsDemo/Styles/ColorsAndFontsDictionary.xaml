    <SolidColorBrush
        x:Key="Primary900Brush" po:Freeze="true"
        Opacity="1"
        Color="{StaticResource Primary900}" />



    <!--  Text  -->
    <!--  Default Text  -->
    <sys:Double x:Key="DefaultFontSize">16</sys:Double>
    <sys:Double x:Key="LargeFontSize">28</sys:Double>
    <sys:Double x:Key="ExtraLargeFontSize">40</sys:Double>
    <sys:Double x:Key="SmallFontSize">12</sys:Double>
    <sys:Double x:Key="ExtraSmallFontSize">10</sys:Double>
    <sys:Double x:Key="ToastFontSize">14</sys:Double>

    <Style TargetType="{x:Type Label}">
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text Semibold" />
    </Style>
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text Semibold" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource DefaultFontSize}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text Semibold" />
    </Style>

    <Style x:Key="HeaderTextBlock" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource ExtraLargeFontSize}" />
        <Setter Property="FontFamily" Value="Segoe UI Black" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SubHeaderTextBlock" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource LargeFontSize}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="ToastTextBlock" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource ToastFontSize}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text Semibold" />
    </Style>

</ResourceDictionary>