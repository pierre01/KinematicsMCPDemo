<UserControl x:Class="KinematicsDemo.UserControls.HeightIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:KinematicsDemo.UserControls"
    xmlns:viewmodels="clr-namespace:KinematicsDemo.ViewModels"
    x:Name="robotHeightIndicator"
    d:DesignHeight="450" d:DesignWidth="510.894"
    Background="White" mc:Ignorable="d">
    <Grid>
        <Canvas Margin="0,0,0,16">
            <Image
                Width="409" Height="350"
                d:IsHidden="True" RenderTransformOrigin="0.5,0.5"
                Source="/Image1.png" Stretch="Fill">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1" />
                        <SkewTransform />
                        <RotateTransform />
                        <TranslateTransform />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Rectangle
                Canvas.Left="83" Canvas.Top="27"
                Width="36" Height="279"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" Fill="#4b5962"
                RadiusX="4.833" RadiusY="4.833"
                Stroke="Black" />
            <Border
                Canvas.Left="118" Canvas.Top="136"
                Width="251" Height="147"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" Background="#33191919"
                BorderBrush="Black" BorderThickness="0,1,0,1" />
            <Rectangle
                Canvas.Left="141" Canvas.Top="130"
                Width="1" Height="159"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" Stroke="Black" />
            <Rectangle
                Canvas.Left="231" Canvas.Top="130"
                Width="1" Height="159"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" Stroke="Black" />
            <Rectangle
                Canvas.Left="311" Canvas.Top="130"
                Width="1" Height="159"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" Stroke="Black" />
            <Canvas
                Canvas.Left="118" Canvas.Top="211"
                Width="301" Height="85"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform />
                        <TranslateTransform Y="0" x:Name="ArmTranslate" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Rectangle
                    Width="48" Height="23"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Fill="#4b5962" RadiusX="1.375"
                    RadiusY="1.375" RenderTransformOrigin="0.5,0.5"
                    Stroke="Black" />
                <Rectangle
                    Canvas.Left="5" Canvas.Top="23"
                    Width="130" Height="25"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Fill="#FF738896" RadiusX="2.125"
                    RadiusY="2.125" RenderTransformOrigin="0.5,0.5"
                    Stroke="Black" />
                <Rectangle
                    Canvas.Left="90" Canvas.Top="48"
                    Width="118" Height="16"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Fill="#FF869BB0" RadiusX="2.125"
                    RadiusY="2.125" RenderTransformOrigin="0.5,0.5"
                    Stroke="Black" />
                <Rectangle
                    Canvas.Left="177" Canvas.Top="64"
                    Width="41" Height="15"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" Fill="#FFA0BFD5"
                    RadiusX="2.125" RadiusY="2.125"
                    RenderTransformOrigin="0.5,0.5" Stroke="Black" />
                <Rectangle
                    Canvas.Left="217" Canvas.Top="69"
                    Width="40" Height="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" Fill="#FFA0BFD5"
                    RenderTransformOrigin="0.5,0.5" Stroke="Black" />
                <Rectangle
                    Canvas.Top="71" Width="266"
                    Height="1" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Stroke="#FFF99400" />
                <TextBlock
                    x:Name="ArmHeightTextBlock"
                    Canvas.Left="263" Canvas.Top="58"
                    Height="27"
                    Text="0.00"
                    FontWeight="Bold" />
                <Ellipse
                    Canvas.Left="234" Canvas.Top="66"
                    Width="13" Height="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top" Stroke="#FFF99400"
                    StrokeThickness="3" />
            </Canvas>

            <Rectangle
                Canvas.Left="358" Canvas.Top="130"
                Width="1" Height="160"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" Stroke="#FFF99400" />
            <Rectangle
                Canvas.Left="62" Canvas.Top="301"
                Width="91" Height="27"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" Fill="#a8b4c1"
                RadiusX="4.833" RadiusY="4.833"
                Stroke="Black" />
            <Label
                Canvas.Left="350" Canvas.Top="284"
                HorizontalAlignment="Left"
                VerticalAlignment="Center" Content="0" />
            <TextBlock x:Name="MaxHeightTextBlock"
                Canvas.Left="332" Canvas.Top="109"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Text="400" />

        </Canvas>

    </Grid>
</UserControl>
