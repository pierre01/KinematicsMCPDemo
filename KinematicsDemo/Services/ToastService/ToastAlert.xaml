<UserControl
    x:Class="KinematicsDemo.Services.ToastService.ToastAlert"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Right"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid
        MinHeight="52"
        HorizontalAlignment="Right"
        RenderTransformOrigin="0.5,0.5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="Auto" />

        </Grid.ColumnDefinitions>

        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="ToastScale" ScaleY="-1" />
                <SkewTransform />
                <RotateTransform />
                <TranslateTransform />
            </TransformGroup>
        </Grid.RenderTransform>
        <Border
            x:Name="ToastBorder"
            Grid.ColumnSpan="3"
            Margin="2"
            Background="{DynamicResource StaticGray100Brush}"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="4,4,4,4" />
        <TextBlock
            x:Name="ToastText"
            Margin="16,8,16,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="{StaticResource ToastFontSize}"
            Text="Hello"
            TextWrapping="Wrap" />
        <Rectangle
            x:Name="SeparatorRect"
            Grid.Column="1"
            Margin="0,8,0,8"
            Fill="{DynamicResource StaticGray500Brush}"
            Opacity=".5" />
        <Path
            x:Name="CloseButton"
            Grid.Column="2"
            Width="16"
            Height="16"
            Margin="8,0,8,0"
            HorizontalAlignment="Center"
            Data="M5.1163335,0C6.4203386,-9.1704351E-08,7.7243743,0.4009941,8.7273803,1.4039678L16.150495,8.1248624 23.27359,1.704927C25.27963,-0.10003502 28.489671,-0.10003502 30.495712,1.704927 32.502731,3.5109269 32.502731,6.4198744 30.495712,8.2258736L23.373596,14.745721 30.094705,20.864637C32.100749,22.670576 32.100749,25.579523 30.094705,27.385523 28.088663,29.190485 24.878623,29.190485 22.871604,27.385523L16.150495,21.26563 9.1293941,27.585531C7.122345,29.39147 3.9123056,29.39147 1.9062939,27.585531 -0.099748187,25.780569 -0.099748187,22.870584 1.9062939,21.065622L8.9283719,14.745721 1.5052868,7.9248535C-0.50176227,6.1188537 -0.50176227,3.2099065 1.5052868,1.4039678 2.5082927,0.50200556 3.8122978,-9.1704351E-08 5.1163335,0z"
            Fill="{DynamicResource StaticGray700Brush}"
            MouseLeftButtonDown="Path_MouseLeftButtonDown"
            Stretch="Fill"
            Stroke="#64FFFFFF"
            StrokeThickness="1" />

    </Grid>
</UserControl>
