<Window
    x:Class="KinematicsDemo.Services.ToastService.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="302"
    Height="600"
    MinWidth="340"
    MinHeight="600"
    MaxWidth="340"
    MaxHeight="600"
    AllowsTransparency="True"
    Background="{x:Null}"
    MouseLeftButtonDown="WindowDrag"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="ListBoxItemsPanel1">
            <StackPanel Orientation="Vertical">
                <Behaviors:Interaction.Behaviors>
                    <Behaviors:FluidMoveBehavior AppliesTo="Children" Duration="00:00:00.3">
                        <Behaviors:FluidMoveBehavior.EaseX>
                            <CubicEase EasingMode="EaseOut" />
                        </Behaviors:FluidMoveBehavior.EaseX>
                        <Behaviors:FluidMoveBehavior.EaseY>
                            <CubicEase EasingMode="EaseOut" />
                        </Behaviors:FluidMoveBehavior.EaseY>
                    </Behaviors:FluidMoveBehavior>
                </Behaviors:Interaction.Behaviors>
            </StackPanel>
        </ItemsPanelTemplate>
        <Style x:Key="ListBoxItemContainerStyle1" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid>
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid >
        <ListBox 
            x:Name="ToastList"
            Background="{x:Null}"
            BorderBrush="{x:Null}"
            ItemContainerStyle="{DynamicResource ListBoxItemContainerStyle1}"
            ItemsPanel="{DynamicResource ListBoxItemsPanel1}"
            RenderTransformOrigin="0.5,0.5">
            <ListBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ListScale" ScaleY="-1" />
                    <SkewTransform />
                    <RotateTransform />
                </TransformGroup>
            </ListBox.RenderTransform>
        </ListBox>
    </Grid>
</Window>
