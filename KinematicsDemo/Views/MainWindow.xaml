<Window
    x:Class="KinematicsDemo.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:KinematicsDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Canvas x:Name="MainCanvas" RenderTransformOrigin="0,0.5">
         <Rectangle Height="230" Canvas.Left="197" Stroke="Black" Canvas.Top="155" Width="32" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Rectangle Height="159" Canvas.Left="101" Stroke="Black" Canvas.Top="156" Width="224" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Rectangle Height="165" Canvas.Left="242" Stroke="Black" Canvas.Top="113" Width="164" HorizontalAlignment="Left" VerticalAlignment="Center"/>
       <Ellipse
            Canvas.Left="101"
            Canvas.Top="84"
            Width="224"
            Height="224"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Stroke="#7F000000"
            StrokeDashArray="3"
            StrokeDashOffset="3" />
        <Ellipse
            x:Name="ShoulderJoint"
            Canvas.Left="197"
            Canvas.Top="180"
            Width="32"
            Height="32"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Fill="#FFBB0000"
            Stroke="Black" />
        <Canvas
            x:Name="FullArm"
            Canvas.Left="213"
            Canvas.Top="180"
            Width="128"
            Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            RenderTransformOrigin="0,0.5">
            <Canvas
                x:Name="UpperArm"
                Canvas.Left="0"
                Canvas.Top="0"
                Width="128"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">
                <Rectangle
                    x:Name="Radius"
                    Width="112"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stroke="Black"
                    StrokeDashArray="3"
                    StrokeDashOffset="3"
                    StrokeStartLineCap="Square" />
                <Ellipse
                    x:Name="ElbowJoint"
                    Canvas.Left="96"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stroke="Black"
                    StrokeDashArray="3"
                    StrokeDashOffset="3" />
            </Canvas>
            <Canvas
                x:Name="ForeArm"
                Canvas.Left="111"
                Width="99"
                Height="32"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#4CC52E2E"
                RenderTransformOrigin="0,0.5">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="0" />
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Ellipse
                    Canvas.Left="-80"
                    Canvas.Top="-64"
                    Width="160"
                    Height="160"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Stroke="#7F000000"
                    StrokeDashArray="3"
                    StrokeDashOffset="3" />
                <Rectangle
                    x:Name="Humerus"
                    Width="80"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Stroke="Black"
                    StrokeDashArray="3"
                    StrokeDashOffset="3"
                    StrokeStartLineCap="Square" />
                <Ellipse
                    x:Name="WristJoint"
                    Canvas.Left="64"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Stroke="Black"
                    StrokeDashArray="3"
                    StrokeDashOffset="3" />
                <Ellipse
                    x:Name="WristJointDragPoint"
                    Canvas.Left="64"
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Fill="#BF008000">
                    <i:Interaction.Behaviors>
                        <i:MouseDragElementBehavior DragFinished="WristJoint_DragFinished" Dragging="WristJoint_Dragging" />
                    </i:Interaction.Behaviors>
                </Ellipse>
            </Canvas>
            <Canvas.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="0" />
                </TransformGroup>
            </Canvas.RenderTransform>
        </Canvas>
        <Ellipse
            x:Name="ElbowJointDragPoint"
            Canvas.Left="309"
            Canvas.Top="180"
            Width="32"
            Height="32"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AllowDrop="True"
            Fill="#BF008000">
            <i:Interaction.Behaviors>
                <i:MouseDragElementBehavior
                    ConstrainToParentBounds="True"
                    DragFinished="ElbowJoint_DragFinished"
                    Dragging="ElbowJoint_Dragging" />
            </i:Interaction.Behaviors>
        </Ellipse>
        <Grid
            x:Name="ValuesPanel"
            Canvas.Left="609"
            Canvas.Top="10"
            Height="110"
            HorizontalAlignment="Center"
            VerticalAlignment="Top">
            <TextBox
                x:Name="AngleTextBox"
                Width="181"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Text="TextBox"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="XDragTextBox"
                Width="181"
                Margin="0,23,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Text="TextBox"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="YDragTextBox"
                Width="181"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="TextBox"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="XDragTextBoxEnd"
                Width="181"
                Margin="0,69,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Text="TextBox"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="YDragTextBoxEnd"
                Width="181"
                Margin="0,92,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Text="TextBox"
                TextWrapping="Wrap" />
        </Grid>
    </Canvas>
</Window>

