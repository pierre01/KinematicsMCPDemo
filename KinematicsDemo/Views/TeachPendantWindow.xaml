<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:KinematicsDemo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:KinematicsDemo.ViewModels"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    x:Class="KinematicsDemo.Views.TeachPendantWindow"
    Title="Teach Pendant Window" Width="563"
    Height="490"
    d:DataContext="{d:DesignInstance {x:Type viewmodels:TeachPendantViewModel}}"
    Closing="WindowClosing" ResizeMode="NoResize"
    ShowInTaskbar="False" Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ToolWindow" mc:Ignorable="d">
    <Window.Resources>
        <Storyboard x:Key="AnimateSignal">
            <ColorAnimation RepeatBehavior="Forever" AutoReverse="True"  Storyboard.TargetName="SignalImage" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
			                From="Black" To="Red" Duration="0:0:0.6">
                <ColorAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </ColorAnimation.EasingFunction>
            </ColorAnimation>
        </Storyboard>
        <ControlTemplate x:Key="ExpanderToggleButton" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Border x:Name="Border" Background="White" BorderBrush="Black" BorderThickness="1,1,0,1" CornerRadius="12,0,0,12" SnapsToDevicePixels="True" Width="24" Height="26" Margin="0,-1,0,0">
                    <Path x:Name="Arrow" Fill="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M14,7L9,12L14,17V7Z" Margin="6,4,11,4" Stretch="Fill" RenderTransformOrigin="0.5,0.5"    >
                        <Path.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                </Border>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualStateGroup.Transitions>
                            <VisualTransition GeneratedDuration="00:00:00.5000000"/>
                        </VisualStateGroup.Transitions>
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="MouseOver">
                            <Storyboard>
                                <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                    <EasingColorKeyFrame KeyTime="00:00:00" Value="#FFD4D4D4"/>
                                </ColorAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Pressed" >
                            <Storyboard>
                                <ColorAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)">
                                    <EasingColorKeyFrame KeyTime="00:00:00" Value="White"/>
                                </ColorAnimationUsingKeyFrames>
                                <ColorAnimationUsingKeyFrames Storyboard.TargetName="Border" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                    <EasingColorKeyFrame KeyTime="00:00:00" Value="#FF2B2929"/>
                                </ColorAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Disabled"/>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="CheckStates">
                        <VisualStateGroup.Transitions>
                            <VisualTransition GeneratedDuration="00:00:00.5000000"/>
                        </VisualStateGroup.Transitions>
                        <VisualState x:Name="Checked">
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Arrow" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
                                    <EasingDoubleKeyFrame KeyTime="00:00:00" Value="180"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Unchecked" />
                        <VisualState x:Name="Indeterminate" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </ControlTemplate>
    </Window.Resources>
    <Grid Margin="8">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="RecordedPointsPanelStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="00:00:00.5000000">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="ClosedPointsPanelState"/>
                <VisualState x:Name="OpenPointsPanelState">
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RecordedPointsPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                            <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0"/>
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1"  Orientation="Horizontal" Grid.Row="3">
            <Button Command="{Binding PlayCommand}" Margin="4" Content="Play" Width="100" Height="32" />
            <Button Command="{Binding StopPlayCommand}"  Margin="4" Content="Stop" Width="100" Height="32" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal">
            <Label Content="Step precision:" />
            <Label Content="{Binding StepPrecisionString, FallbackValue=1 mm}" />
        </StackPanel>
        <Slider
            Grid.Row="1" 
            Grid.ColumnSpan="2"
            Margin="8" HorizontalAlignment="Stretch"
            Maximum="20"
            Minimum="1" TickPlacement="Both"
            Value="{Binding StepPrecision}" SmallChange="1" AutoToolTipPlacement="BottomRight" LargeChange="4" Cursor="ScrollWE" IsSnapToTickEnabled="True" />
        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <RepeatButton
                ToolTip="Go West"
                Grid.Row="1" Margin="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding GoWestCommand, Mode=OneWay}"
                Interval="50">
                <Path
                    Width="48" Height="48"
                    Data="M22,12A10,10 0 0,0 12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12M20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12M14,7L9,12L14,17V7Z"
                    Fill="#f0513f" Stretch="Fill" />
            </RepeatButton>
            <RepeatButton
                ToolTip="Go East"
                Grid.Row="1" Grid.Column="2"
                Margin="8" HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding GoEastCommand, Mode=OneWay}"
                Interval="50" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="{x:Null}">
                <Path
                    Width="48" Height="48"
                    Data="M2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2A10,10 0 0,0 2,12M4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12M10,17L15,12L10,7V17Z"
                    Fill="#f0513f" Stretch="Fill" />
            </RepeatButton>
            <Button
                ToolTip="Record"
                Grid.Row="1" Grid.Column="1"
                Margin="8" HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding RecordPointCommand, Mode=OneWay}">
                <Path
                    Width="48" Height="48"
                    Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"
                    Fill="#fbb01f" Stretch="Fill" ToolTip="Record Point" />
            </Button>
            <RepeatButton
                ToolTip="Go North"
                Grid.Column="1" Margin="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Command="{Binding GoNorthCommand, Mode=OneWay}"
                Interval="50" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="{x:Null}">
                <Path
                    Width="48" Height="48"
                    Data="M12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M17,14L12,9L7,14H17Z"
                    Fill="#8dc63f" Stretch="Fill" />
            </RepeatButton>
            <RepeatButton
                ToolTip="Go South"
                Grid.Row="2" Grid.Column="1"
                Margin="8" HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Command="{Binding GoSouthCommand, Mode=OneWay}"
                Interval="50">
                <Path
                    Width="48" Height="48"
                    Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M7,10L12,15L17,10H7Z"
                    Fill="#8dc63f" Stretch="Fill" />
            </RepeatButton>
            <RepeatButton
                ToolTip="Go Backward"
                Grid.Row="3" Margin="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Command="{Binding GoBackwardCommand, Mode=OneWay}"
                Interval="50">
                <Path
                    Width="40" Height="40"
                    Data="M7,12L12,7V10H16V14H12V17L7,12M21,5V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V5A2,2 0 0,1 5,3H19A2,2 0 0,1 21,5M19,5H5V19H19V5Z"
                    Fill="Purple" Stretch="Fill" />
            </RepeatButton>
            <RepeatButton
                ToolTip="Go Forward"
                Grid.Row="3" Grid.Column="2"
                Margin="8" HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Command="{Binding GoForwardCommand, Mode=OneWay}"
                Interval="50">
                <Path
                    Width="40" Height="40"
                    Data="M17,12L12,17V14H8V10H12V7L17,12M3,19V5A2,2 0 0,1 5,3H19A2,2 0 0,1 21,5V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19M5,19H19V5H5V19Z"
                    Fill="Purple" Stretch="Fill" />
            </RepeatButton>
            <RepeatButton
                ToolTip="Go Down"
                Grid.Row="2" Grid.Column="3"
                Margin="8" HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Command="{Binding GoDownCommand, Mode=OneWay}"
                Interval="50">
                <Path
                    Width="40" Height="40"
                    Data="M12,17L7,12H10V8H14V12H17L12,17M5,3H19A2,2 0 0,1 21,5V19A2,2 0 0,1 19,21H5A2,2 0 0,1 3,19V5A2,2 0 0,1 5,3M5,5V19H19V5H5Z"
                    Fill="#00aeef" Stretch="Fill" />
            </RepeatButton>
            <RepeatButton
                ToolTip="Go Up"
                Grid.Column="3" 
                Margin="8,0,0,0" HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Command="{Binding GoUpCommand, Mode=OneWay}"
                Interval="50" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="{x:Null}">
                <Path
                    Width="40" Height="40"
                    Data="M12,7L17,12H14V16H10V12H7L12,7M19,21H5A2,2 0 0,1 3,19V5A2,2 0 0,1 5,3H19A2,2 0 0,1 21,5V19A2,2 0 0,1 19,21M19,19V5H5V19H19Z"
                    Fill="#00aeef" Stretch="Fill" />
            </RepeatButton>
            <Path
                Grid.Row="3" Grid.Column="1"
                Width="48" Height="28"
                Data="M6.45,17.45L1,12L6.45,6.55L7.86,7.96L4.83,11H19.17L16.14,7.96L17.55,6.55L23,12L17.55,17.45L16.14,16.04L19.17,13H4.83L7.86,16.04L6.45,17.45Z"
                Fill="#989898" Stretch="Fill" />
            <Path
                Grid.Row="1" Grid.Column="3"
                Width="28" Height="48"
                Data="M17.45,17.55L12,23L6.55,17.55L7.96,16.14L11,19.17V4.83L7.96,7.86L6.55,6.45L12,1L17.45,6.45L16.04,7.86L13,4.83V19.17L16.04,16.14L17.45,17.55Z"
                Fill="#989898" Stretch="Fill" />
            <!--<Path Fill="#000000" Grid.Column="1" Grid.Row="3" Stretch="Fill"  Data="M14,16V22L24,12L14,2V8H10V2L0,12L10,22V16H14M8,14V17L3,12L8,7V10H16V7L21,12L16,17V14H8Z" Height="32" Width="58" />-->

        </Grid>
        <Grid Grid.Column="1" MaxWidth="160"  Grid.Row="2"   >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Grid.ColumnSpan="2" HorizontalAlignment="Center" Height="100" VerticalAlignment="Top" Source="/Views/3dAxis.png"/>
            <Label Grid.Row="1" Grid.Column="0" Content="X" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFF0513F" />
            <Label Grid.Row="1" Grid.Column="1" Content="{Binding XString, FallbackValue=0.00}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <Label Grid.Row="2" Grid.Column="0" Content="Y" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF8DC63F" />
            <Label Grid.Row="2" Grid.Column="1" Content="{Binding YString, FallbackValue=0.00}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <Label Grid.Row="3" Grid.Column="0" Content="Z" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF00AEEF" />
            <Label Grid.Row="3" Grid.Column="1" Content="{Binding ZString, FallbackValue=0.00}" HorizontalAlignment="Right" VerticalAlignment="Center" />

            <Label Grid.Row="4" Grid.Column="0" Content="Rail" HorizontalAlignment="Center" Foreground="Purple" VerticalAlignment="Top" />
            <Label Grid.Row="4" Grid.Column="1" Content="{Binding RailPositionString, FallbackValue=0.00}" HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>
        <Border x:Name="RecordedPointsPanel" Grid.Column="1" MaxWidth="400"  Grid.Row="2" BorderBrush="Black" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform X="253"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ToggleButton Template="{StaticResource ExpanderToggleButton}" x:Name="toggleButton"  Content="&lt;" VerticalAlignment="Top" Margin="-20,0,0,0" Padding="4,4,4,4" HorizontalAlignment="Left" Grid.RowSpan="2" >
                    <b:Interaction.Triggers>
                        <b:EventTrigger SourceObject="{Binding ElementName=toggleButton}" EventName="Checked">
                            <b:GoToStateAction StateName="OpenPointsPanelState"/>
                        </b:EventTrigger>
                        <b:EventTrigger SourceObject="{Binding ElementName=toggleButton}" EventName="Unchecked">
                            <b:GoToStateAction StateName="ClosedPointsPanelState"/>
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ToggleButton>
                <ListView BorderThickness="0,0,0,0" ClipToBounds="True" Grid.RowSpan="2" ItemsSource="{Binding RecordedMetaPoints, Mode=OneWay}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="X" DisplayMemberBinding="{Binding MousePoint.X}"    Width="60" />
                            <GridViewColumn Header="Y" DisplayMemberBinding="{Binding MousePoint.Y}"    Width="60" />
                            <GridViewColumn Header="Z" DisplayMemberBinding="{Binding ZPosition}"       Width="60" />
                            <GridViewColumn Header="Rail" DisplayMemberBinding="{Binding RailPosition}" Width="60" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
        <ToggleButton Command="{Binding SwitchRemoteModeCommand}" x:Name="ToggleServerButton" Style="{StaticResource BaseButtonStyle}" Grid.Column="1"  HorizontalAlignment="Right"  VerticalAlignment="Center" Margin="0,0,8,0" Width="38" ToolTip="{Binding RemoteModeTooltip}" CommandParameter="{Binding IsChecked, ElementName=ToggleServerButton}" Checked="ToggleServerButton_Checked" Unchecked="ToggleServerButton_Unchecked">
            <Path x:Name="SignalImage" Fill="Black" Data="M4.93,4.93C3.12,6.74 2,9.24 2,12C2,14.76 3.12,17.26 4.93,19.07L6.34,17.66C4.89,16.22 4,14.22 4,12C4,9.79 4.89,7.78 6.34,6.34L4.93,4.93M19.07,4.93L17.66,6.34C19.11,7.78 20,9.79 20,12C20,14.22 19.11,16.22 17.66,17.66L19.07,19.07C20.88,17.26 22,14.76 22,12C22,9.24 20.88,6.74 19.07,4.93M7.76,7.76C6.67,8.85 6,10.35 6,12C6,13.65 6.67,15.15 7.76,16.24L9.17,14.83C8.45,14.11 8,13.11 8,12C8,10.89 8.45,9.89 9.17,9.17L7.76,7.76M16.24,7.76L14.83,9.17C15.55,9.89 16,10.89 16,12C16,13.11 15.55,14.11 14.83,14.83L16.24,16.24C17.33,15.15 18,13.65 18,12C18,10.35 17.33,8.85 16.24,7.76M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10Z" Stretch="UniformToFill" Margin="4,4,4,4" />
        </ToggleButton>
    </Grid>
</Window>
