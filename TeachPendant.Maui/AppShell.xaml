<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Biosero.TeachPendant.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Biosero.TeachPendant.Maui.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Biosero.TeachPendant.Maui">

    <TabBar>
        <Tab>
            <ShellContent 
                Title="Remote"
                ContentTemplate="{DataTemplate views:TeachPendantView}"
                Route="TeachPendantView"/>
            <ShellContent 
                Title="Speak"
                ContentTemplate="{DataTemplate views:SpeechRecognitionView}"
                Route="SpeechRecognitionView"/>
            <ShellContent
                Title="Recorded Points"
                ContentTemplate="{DataTemplate views:RecordedPointsView}"
                Route="RecordedPointsView"/>
            <ShellContent 
                Title="Settings"
                ContentTemplate="{DataTemplate views:SettingsView}"
                Route="SettingsView"/>
        </Tab>
    </TabBar>
</Shell>
