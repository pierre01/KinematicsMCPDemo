<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Biosero.TeachPendant.Maui.ViewModels"
    x:Class="Biosero.TeachPendant.Maui.Views.SpeechRecognitionView"
    Title="Speech Recognition">
    <VerticalStackLayout>
        <Editor
            x:Name="UserInput_Editor"
            Placeholder="Enter your response here or speak to the mic"
            HeightRequest="150"
            WidthRequest="360"
            TextChanged="UserInput_Changed"/>
        <Label 
            Text="Responses: "
            Margin="0,10,0,0"
            WidthRequest="360"/>
        <Label
            Text="{Binding PluginResponse}"
            HeightRequest="150"
            WidthRequest="360"/>
        <Label 
            Text="AI Explaination: "
            Margin="0,10,0,0"
            WidthRequest="360"/>
        <Label 
            Text="{Binding AiResponse}"
            HeightRequest="150"
            WidthRequest="360"/>
        <Button 
            x:Name="SpeakButton"
            Clicked="OnStartListening"
            Text="Speak"
            WidthRequest="100"/>
    </VerticalStackLayout>
</ContentPage>