<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Biosero.TeachPendant.Maui.ViewModels"
    x:Class="Biosero.TeachPendant.Maui.Views.SettingsView"
    Title="Settings">
    <VerticalStackLayout>
        <HorizontalStackLayout
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <Label 
                Text="Web Service IP Address: "
                VerticalOptions="Center" 
                HorizontalOptions="Center" />
            <Entry 
                Placeholder="Enter IP Address"
                Text="{Binding WebServiceEndpoint}"
                VerticalOptions="Center" 
                HorizontalOptions="Center"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>